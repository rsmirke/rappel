[Desktop Entry]
Name=Rappel
# Translators: A short name for what the app is, shown next to its name in some menus.
GenericName=Flashcards
# Translators: A tooltip in the menus; the same text as the summary in the app's store listing.
Comment=Memorize with flashcards
