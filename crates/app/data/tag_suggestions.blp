using Gtk 4.0;

// The tag suggestions under a tag entry (a popover parented to its frame;
// widgets/tag_entry.rs), in the card editor and Add Tags. It never takes
// the keyboard focus: the entry keeps it, and the arrow keys move the
// highlight (widgets/tag_suggestions.rs). Rows are added in code, one per
// suggestion; tag names are untrusted, so the labels do not use markup.
template $RappelTagSuggestions: Gtk.Popover {
  autohide: false;
  has-arrow: false;
  position: bottom;
  halign: start;

  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;
    propagate-natural-height: true;
    max-content-height: 260;

    child: Gtk.ListBox list {
      // Not focusable: a click must not take the focus from the entry
      // (that would close the list before the row is activated).
      focusable: false;
      selection-mode: single;
      activate-on-single-click: true;

      styles [
        "navigation-sidebar",
      ]

      accessibility {
        label: _("Tag suggestions");
      }
    };
  };
}
