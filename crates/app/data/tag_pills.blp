using Gtk 4.0;
using Adw 1;

// A card's tags as small rounded pills (`.tag-pill` in data/style.css).
// The pills are plain labels made in widgets/tag_pills.rs: tag names are
// untrusted, so nothing here parses markup. One of the two boxes is shown:
// the wrap box where the pills may take several lines (the editor), the
// single line in a list row, where the tags past a few become one "+N"
// pill.
template $RappelTagPills: Gtk.Box {
  // Natural: each pill keeps its whole name on one line while it fits the
  // field (a removable pill's name wraps only when wider than the field;
  // ADR 0058), rather than being shrunk to its longest word.
  Adw.WrapBox wrap_box {
    child-spacing: 6;
    line-spacing: 6;
    wrap-policy: natural;
  }

  Gtk.Box line_box {
    visible: false;
    spacing: 6;
  }
}
