using Gtk 4.0;
using Adw 1;

// The summary shown before an import. transfer/mod.rs (a Rappel export)
// and transfer/anki.rs (an Anki package) set the heading and body, and for
// "Cannot Import" and "Nothing to Import" remove Import and relabel Cancel
// as Close.
Adw.AlertDialog import_dialog {
  close-response: "cancel";
  default-response: "import";

  responses [
    cancel: _("_Cancel"),
    import: _("_Import") suggested,
  ]

  // The conflicts (a Rappel export) or the report of what is left out (an
  // Anki package), one per line. Plain text: the conflicts' names are the
  // user's own, the report's examples the package's, all untrusted card
  // content.
  extra-child: Gtk.Label conflicts_label {
    visible: false;
    use-markup: false;
    wrap: true;
    wrap-mode: word_char;
    xalign: 0;
  };
}
