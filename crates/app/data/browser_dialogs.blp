using Gtk 4.0;
using Adw 1;

// Asks for one of a list: a deck to move cards to, or a tag to take off
// them. The heading, the body and the confirm label are set in
// dialogs/browser_dialogs.rs.
Adw.AlertDialog choose_dialog {
  close-response: "cancel";
  default-response: "confirm";

  responses [
    cancel: _("_Cancel"),
    confirm: _("_OK") suggested,
  ]

  extra-child: Gtk.DropDown choice_dropdown {
    enable-search: true;
  };
}

// Asks for tags to put on cards, in the card editor's tag entry: pills,
// suggestions of the tags there are, the same keys (ADR 0051). The body is
// set in dialogs/browser_dialogs.rs; Add is enabled once there is a tag to
// add, and the entry shows its own errors under it.
Adw.AlertDialog add_tags_dialog {
  heading: _("Add Tags");
  close-response: "cancel";
  default-response: "confirm";

  responses [
    cancel: _("_Cancel"),
    confirm: _("_Add") suggested,
  ]

  extra-child: $RappelTagEntry add_tags_entry {};
}
