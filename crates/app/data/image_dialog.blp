using Gtk 4.0;
using Adw 1;

// An image of a card at full size (render/picture.rs). Its title (the alt
// text, or "Image") and the picture are set in code. The picture keeps its
// natural size and is scaled down, never up, to fit the dialog, which
// libadwaita keeps inside the window (a bottom sheet on a narrow one).
// Escape closes it, as every AdwDialog.
Adw.Dialog image_dialog {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle image_title {};
    }

    content: Gtk.Picture image_picture {
      can-shrink: true;
      content-fit: scale_down;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 12;
    };
  };
}
