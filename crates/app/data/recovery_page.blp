using Gtk 4.0;
using Adw 1;

template $RappelRecoveryPage: Adw.Bin {
  // A short window (a phone held sideways, 640 × 360) makes the status
  // page `compact` without its icon, so the backups are on screen
  // (pages/recovery_page.rs, `ui::breakpoint::compact_status_page`;
  // ADR 0058), as the setting page does.
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    Adw.Breakpoint short_breakpoint {
      condition ("max-height: 450sp")
    }

    child: Adw.StatusPage status {
      icon-name: "dialog-warning-symbolic";

      child: Adw.Clamp {
        maximum-size: 480;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 18;

          // Only while an interrupted restore's checked copy waits
          // (pages/recovery_page.rs).
          Gtk.Button finish_restore_button {
            label: _("_Finish Restore");
            use-underline: true;
            halign: center;
            visible: false;

            styles [
              "pill",
              "suggested-action",
            ]
          }

          Gtk.ListBox backup_list {
            selection-mode: none;
            accessibility {
              label: _("Backups");
            }

            styles [
              "boxed-list",
            ]
          }

          // Only with no backups to restore (pages/recovery_page.rs).
          Gtk.Button start_fresh_button {
            label: _("_Start Fresh");
            use-underline: true;
            halign: center;
            visible: false;

            styles [
              "pill",
              "destructive-action",
            ]
          }

          Gtk.Label path_label {
            wrap: true;
            wrap-mode: word_char;
            selectable: true;
            justify: center;

            styles [
              "dimmed",
            ]
          }
        };
      };
    };
  };
}
