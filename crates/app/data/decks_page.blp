using Gtk 4.0;
using Adw 1;

template $RappelDecksPage: Adw.NavigationPage {
  title: _("Rappel");
  tag: "decks";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Gtk.Button {
        icon-name: "list-add-symbolic";
        action-name: "win.new-deck";
        tooltip-text: _("New Deck");

        accessibility {
          label: _("New Deck");
        }
      }

      // The first [end] child is the last in the bar: the main menu, as the
      // HIG puts it, with the search button before it.
      [end]
      Gtk.MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        tooltip-text: _("Main Menu");

        accessibility {
          label: _("Main Menu");
        }
      }

      [end]
      Gtk.Button {
        icon-name: "system-search-symbolic";
        action-name: "win.search";
        tooltip-text: _("Search All Cards");

        accessibility {
          label: _("Search All Cards");
        }
      }
    }

    content: Gtk.Stack content_stack {
      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "accessories-dictionary-symbolic";
          title: _("No Decks Yet");
          description: _("Create a deck to start adding cards");

          child: Gtk.Button empty_new_button {
            label: _("_Create Deck");
            use-underline: true;
            action-name: "win.new-deck";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      Gtk.StackPage {
        name: "list";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 600;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Gtk.ListBox deck_list {
              selection-mode: none;
              valign: start;

              accessibility {
                label: _("Decks");
              }

              styles [
                "boxed-list",
              ]
            };
          };
        };
      }
    };
  };
}

// The primary menu (F10). The last section is Preferences, Keyboard
// Shortcuts and About, in the order the GNOME HIG gives. Preferences and
// Keyboard Shortcuts show their keys from the application's accelerators.
menu primary_menu {
  section {
    item {
      label: _("_Statistics");
      action: "decks.statistics";
    }
  }

  section {
    item {
      label: _("_Export…");
      action: "win.export";
    }

    item {
      label: _("_Import…");
      action: "win.import";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Rappel");
      action: "win.about";
    }
  }
}
