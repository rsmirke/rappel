using Gtk 4.0;
using Adw 1;

// All Cards: search, filters and the list of every card, with actions on
// several cards at once (ADR 0036, 0044). The texts that change are set in
// pages/browser_page.rs (from browser_page/text.rs); deck and tag names
// (untrusted) only ever reach plain-text widgets.
template $RappelBrowserPage: Adw.NavigationPage {
  title: _("All Cards");

  // The bin's size request is the window's minimum (data/window.blp), as
  // on the deck page.
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    // A phone: no card count beside the filters (they need the width),
    // fewer pills in the rows, Select All and the action buttons without
    // their words.
    Adw.Breakpoint breakpoint {
      condition ("max-width: 500sp")

      setters {
        count_label.visible: false;
        select_all_content.label: "";
        move_content.label: "";
        tags_content.label: "";
        reset_content.label: "";
        delete_content.label: "";
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // The search field, or, while cards are being chosen, how many are
        // (HIG, "Selection mode": a cancel button, and the heading says
        // the number of selected items).
        title-widget: Gtk.Stack title_stack {
          hhomogeneous: false;

          Gtk.StackPage {
            name: "search";

            child: Adw.Clamp {
              maximum-size: 400;
              tightening-threshold: 300;

              child: Gtk.SearchEntry search_entry {
                placeholder-text: _("Search cards");
                search-delay: 150;
                hexpand: true;

                accessibility {
                  label: _("Search cards");
                }
              };
            };
          }

          Gtk.StackPage {
            name: "selection";

            child: Adw.WindowTitle selection_title {};
          }
        };

        // While choosing; the page cannot be popped then, so Back hides.
        [start]
        Gtk.Button select_all_button {
          visible: false;
          action-name: "browser.select-all";
          tooltip-text: _("Select All");

          accessibility {
            label: _("Select All");
          }

          child: Adw.ButtonContent select_all_content {
            icon-name: "edit-select-all-symbolic";
            label: _("Select _All");
            use-underline: true;
          };
        }

        [end]
        Gtk.Button select_button {
          icon-name: "selection-mode-symbolic";
          action-name: "browser.choose";
          tooltip-text: _("Select Cards");

          accessibility {
            label: _("Select Cards");
          }
        }

        [end]
        Gtk.Button cancel_button {
          visible: false;
          label: _("_Cancel");
          use-underline: true;
          action-name: "browser.cancel";
        }
      }

      // Deck, tag and state, side by side and as wide as the list under
      // them; on a phone they share the width and their texts end in "…"
      // (ui::dropdown::shrinkable), so they never take more than one line.
      // Hidden while there is no card at all (pages/browser_page.rs).
      [top]
      Adw.Clamp filter_bar {
        maximum-size: 600;

        child: Gtk.Box {
          spacing: 12;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;

          Gtk.Box {
            spacing: 6;
            homogeneous: true;
            hexpand: true;

            Gtk.DropDown deck_filter {
              enable-search: true;
              tooltip-text: _("Deck");

              accessibility {
                label: _("Deck");
              }
            }

            Gtk.DropDown tag_filter {
              enable-search: true;
              tooltip-text: _("Tag");

              accessibility {
                label: _("Tag");
              }
            }

            Gtk.DropDown state_filter {
              tooltip-text: _("State");

              model: Gtk.StringList {
                strings [
                  _("Any State"),
                  _("New"),
                  _("Learning"),
                  _("Due"),
                  _("Suspended"),
                ]
              };

              accessibility {
                label: _("State");
              }
            }
          }

          Gtk.Label count_label {
            xalign: 1;

            styles [
              "caption",
              "dimmed",
              "numeric",
            ]
          }
        };
      }

      content: Gtk.Stack content_stack {
        Gtk.StackPage {
          name: "empty";

          // Short (a phone held sideways, or the on-screen keyboard up), the
          // empty state is `compact` so its button stays on screen (ADR 0058;
          // `ui::breakpoint`). A bin of its own: the condition is on the
          // room the page leaves it.
          child: Adw.BreakpointBin {
            width-request: 300;
            height-request: 200;

            Adw.Breakpoint empty_short {
              condition ("max-height: 400sp")
            }

            child: Adw.StatusPage empty_page {
              child: Gtk.Button empty_button {
                action-name: "browser.empty-action";
                use-underline: true;
                halign: center;

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          };
        }

        Gtk.StackPage {
          name: "list";

          // A GtkListView with a model: it only creates rows for what is
          // on screen, so thousands of cards stay smooth (ADR 0013). As on
          // the deck page: clamped to 600 px, and no `rich-list`, because
          // the rows lay themselves out like action rows
          // (data/card_row.blp).
          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            styles [
              "view",
            ]

            child: Adw.ClampScrollable {
              maximum-size: 600;

              child: Gtk.ListView card_list {
                single-click-activate: true;

                accessibility {
                  label: _("Cards");
                }

                styles [
                  "separators",
                ]
              };
            };
          };
        }
      };

      // The actions on the chosen cards (HIG, "Selection mode": an action
      // bar at the bottom). On a phone the buttons keep only their icons;
      // the tooltips and accessible labels stay.
      [bottom]
      Gtk.ActionBar action_bar {
        revealed: false;

        [start]
        Gtk.Button move_button {
          action-name: "browser.move";
          tooltip-text: _("Move to Deck");

          accessibility {
            label: _("Move selected cards to a deck");
          }

          child: Adw.ButtonContent move_content {
            icon-name: "folder-symbolic";
            label: _("Move…");
          };
        }

        [start]
        Gtk.MenuButton tags_button {
          menu-model: tags_menu;
          tooltip-text: _("Tags");

          accessibility {
            label: _("Tags of selected cards");
          }

          child: Adw.ButtonContent tags_content {
            icon-name: "bookmark-new-symbolic";
            label: _("Tags");
          };
        }

        [start]
        Gtk.Button suspend_button {
          action-name: "browser.suspend-selected";
          tooltip-text: _("Suspend");

          accessibility {
            label: _("Suspend selected cards");
          }

          child: Adw.ButtonContent suspend_content {
            icon-name: "media-playback-pause-symbolic";
            label: _("Suspend");
          };
        }

        [end]
        Gtk.Button delete_button {
          action-name: "browser.delete-selected";
          tooltip-text: _("Delete");

          accessibility {
            label: _("Delete selected cards");
          }

          child: Adw.ButtonContent delete_content {
            icon-name: "user-trash-symbolic";
            label: _("Delete");
          };
        }

        [end]
        Gtk.Button reset_button {
          action-name: "browser.reset-selected";
          tooltip-text: _("Reset Progress");

          accessibility {
            label: _("Reset progress of selected cards");
          }

          child: Adw.ButtonContent reset_content {
            icon-name: "view-refresh-symbolic";
            label: _("Reset");
          };
        }
      }
    };
  };
}

menu tags_menu {
  section {
    item (_("_Add Tags…"), "browser.add-tags")
    item (_("_Remove Tag…"), "browser.remove-tag")
  }
}
