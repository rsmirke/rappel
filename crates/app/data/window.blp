using Gtk 4.0;
using Adw 1;

template $RappelWindow: Adw.ApplicationWindow {
  title: _("Rappel");
  default-width: 640;
  default-height: 560;
  width-request: 360;
  height-request: 294;

  content: Adw.ToastOverlay toast_overlay {
    // One page per startup outcome; window.rs picks the visible one. An
    // AdwViewStack, so the crossfade (after a restore) is libadwaita's
    // transition, as the brief's design rules ask. Like GtkStack's, it is
    // skipped when gtk-enable-animations is off.
    child: Adw.ViewStack stack {
      enable-transitions: true;

      Adw.ViewStackPage {
        name: "main";

        // The deck list pushes deck pages onto this view.
        child: Adw.NavigationView navigation_view {
          $RappelDecksPage decks_page {}
        };
      }

      Adw.ViewStackPage {
        name: "recovery";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: $RappelRecoveryPage recovery_page {};
        };
      }

      Adw.ViewStackPage {
        name: "setting";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: $RappelSettingPage setting_page {};
        };
      }

      Adw.ViewStackPage {
        name: "too-new";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          // A short window (a phone held sideways, 640 × 360) makes the
          // page `compact` without its icon (window.rs, ADR 0058). A bin of
          // its own, as the setting page has: a breakpoint on the window
          // would check the whole content against the window's minimum.
          content: Adw.BreakpointBin {
            width-request: 360;
            height-request: 294;

            Adw.Breakpoint too_new_short {
              condition ("max-height: 450sp")
            }

            child: Adw.StatusPage too_new_page {
              icon-name: "software-update-available-symbolic";
              title: _("Update Rappel to Continue");

              child: Gtk.Label too_new_path {
                wrap: true;
                wrap-mode: word_char;
                selectable: true;
                justify: center;

                styles [
                  "dimmed",
                ]
              };
            };
          };
        };
      }

      Adw.ViewStackPage {
        name: "error";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          // A short window (a phone held sideways, 640 × 360) makes the
          // page `compact` without its icon (window.rs, ADR 0058). A bin of
          // its own, as the setting page has: a breakpoint on the window
          // would check the whole content against the window's minimum.
          content: Adw.BreakpointBin {
            width-request: 360;
            height-request: 294;

            Adw.Breakpoint error_short {
              condition ("max-height: 450sp")
            }

            child: Adw.StatusPage error_page {
              icon-name: "dialog-error-symbolic";
              title: _("Rappel Could Not Start");

              child: Gtk.Label error_details {
                wrap: true;
                wrap-mode: word_char;
                selectable: true;
                justify: center;

                styles [
                  "dimmed",
                ]
              };
            };
          };
        };
      }
    };
  };
}
