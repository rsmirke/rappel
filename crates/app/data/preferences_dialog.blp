using Gtk 4.0;
using Adw 1;

// Preferences (SPEC §4.8, ADR 0027). Values, the day start hours and the
// retention text are set in dialogs/preferences.rs.
Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");
  content-width: 480;

  Adw.PreferencesPage settings_page {
    Adw.PreferencesGroup {
      title: _("Study");
      description: _("Limits count for each deck separately");

      Adw.SpinRow new_per_day {
        title: _("New Cards per Day");
        subtitle: _("The most new cards a deck introduces in a day");
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 9999;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.SpinRow reviews_per_day {
        title: _("Reviews per Day");
        subtitle: _("The most due cards a deck shows in a day; the rest wait for the next day");
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 9999;
          step-increment: 10;
          page-increment: 100;
        };
      }

      Adw.ComboRow day_start {
        title: _("Day Starts At");
        subtitle: _("Studying before this time still counts toward the previous day");
      }
    }

    Adw.PreferencesGroup {
      title: _("Memory");

      Adw.ActionRow retention_row {
        title: _("Desired Retention");
        subtitle: _("How much you want to remember when a card comes due; higher means more reviews");
        use-markup: false;
        activatable: true;

        [suffix]
        Gtk.Label retention_value {
          valign: center;

          styles [
            "dimmed",
            "numeric",
          ]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Data");
      description: _("Rappel backs up your data each day it opens, before an update converts it, and before an import changes it");

      Adw.ButtonRow open_backups {
        title: _("Open Backup Folder");
        start-icon-name: "folder-open-symbolic";
      }
    }
  }
}
