{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(./scripts/check.sh)",
      "Bash(xvfb-run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git checkout --)",
      "Bash(git checkout -- *)",
      "Bash(git -C * checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f *)",
      "Bash(git switch -f *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git restore *)",
      "Bash(git -C * restore *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D)",
      "Bash(git branch * -D *)",
      "Bash(git -C * branch -D *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-main.py"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
